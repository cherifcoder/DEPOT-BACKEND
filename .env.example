# ---------------------------------------------------------------------------
# Base de donnees PostgreSQL
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://depot:depot@localhost:5432/depot_boissons?schema=public"
# Connexion directe (non pooler) pour les migrations Prisma.
# Neon : `neon deploy` / `neon env pull` ecrit les deux chaines dans .env.local
# (DATABASE_URL = pooler, DATABASE_URL_UNPOOLED = direct). En local sans Neon,
# la meme valeur que DATABASE_URL suffit.
DATABASE_URL_UNPOOLED="postgresql://depot:depot@localhost:5432/depot_boissons?schema=public"

# ---------------------------------------------------------------------------
# Serveur
# ---------------------------------------------------------------------------
NODE_ENV="development"
PORT=4000
# URL publique utilisee pour construire les liens des medias (photos, signatures)
PUBLIC_BASE_URL="http://localhost:4000"
# Origines autorisees, separees par des virgules ("*" pour tout autoriser)
CORS_ORIGINS="*"
# Dossier de stockage local des medias (photos produits, signatures, preuves)
UPLOAD_DIR="./uploads"
MAX_UPLOAD_MB=10

# ---------------------------------------------------------------------------
# Authentification JWT
# ---------------------------------------------------------------------------
# Generer avec: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET="dev-access-secret-change-me-in-production"
JWT_REFRESH_SECRET="dev-refresh-secret-change-me-in-production"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL_DAYS=30

# ---------------------------------------------------------------------------
# Notifications push (optionnel - Expo)
# ---------------------------------------------------------------------------
EXPO_ACCESS_TOKEN=""
# Active le planificateur d'alertes (stock bas, creances echues, livraisons en retard)
ENABLE_CRON=true
CRON_TIMEZONE="Africa/Abidjan"

# ---------------------------------------------------------------------------
# Divers
# ---------------------------------------------------------------------------
LOG_LEVEL="info"
