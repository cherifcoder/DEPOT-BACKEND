{
  "name": "@depot/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "postinstall": "prisma generate",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:local": "tsx scripts/local-db.ts",
    "db:start": "tsx scripts/db-control.ts start",
    "db:status": "tsx scripts/db-control.ts status",
    "db:stop": "tsx scripts/db-control.ts stop",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset --force"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dayjs": "^1.11.23",
    "dotenv": "^18.0.9",
    "exceljs": "^4.4.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.5.0",
    "node-cron": "^4.6.0",
    "pdf-lib": "^1.17.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "prisma": "6.19.3",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@neon/config": "^1.14.0",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.10.1",
    "@types/supertest": "^6.0.3",
    "embedded-postgres": "^16.15.0-beta.19",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.1.4",
    "typescript": "5.9.3",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "@embedded-postgres/windows-x64@16.15.0-beta.19": true,
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.28.2": true,
    "prisma@6.19.3": true
  }
}
